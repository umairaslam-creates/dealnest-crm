# Database (Supabase or Neon free tier Postgres connection string)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# The public URL this app is served at, used to build the Google OAuth
# redirect URI. Set to your Vercel URL in production.
NEXTAUTH_URL="http://localhost:3311"

# Google OAuth (Gmail + Calendar) - from Google Cloud Console. Authorized
# redirect URI to register there: <NEXTAUTH_URL>/api/integrations/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# HubSpot import (Private App token from HubSpot settings)
HUBSPOT_TOKEN=""

# AI features - on-demand only, triggered by button/command, never background
OPENAI_API_KEY=""
